{
  "name": "locable-drawing-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "db:migrate:dev": "wrangler d1 migrations apply locable_drawing_manager_dev --local",
    "db:migrate:remote:dev": "wrangler d1 migrations apply locable_drawing_manager_dev --remote",
    "db:migrate:remote:prod": "wrangler d1 migrations apply locable_drawing_manager_prod --remote --env production"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260627.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wrangler": "^4.105.0"
  }
}
